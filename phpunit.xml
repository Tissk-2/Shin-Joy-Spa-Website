<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/phpunit-config.php" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_PREVIOUS_KEYS" value="" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="1" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_USERNAME" value="" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="REDIS_URL" value="" force="true"/>
        <env name="REDIS_USERNAME" value="" force="true"/>
        <env name="REDIS_PASSWORD" value="" force="true"/>
        <env name="MEMCACHED_USERNAME" value="" force="true"/>
        <env name="MEMCACHED_PASSWORD" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_URL" value="" force="true"/>
        <env name="MAIL_USERNAME" value="" force="true"/>
        <env name="MAIL_PASSWORD" value="" force="true"/>
        <env name="POSTMARK_TOKEN" value="" force="true"/>
        <env name="RESEND_KEY" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="LOG_SLACK_WEBHOOK_URL" value="" force="true"/>
        <env name="PAPERTRAIL_URL" value="" force="true"/>
        <env name="SLACK_BOT_USER_OAUTH_TOKEN" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
